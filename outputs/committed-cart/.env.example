SERPAPI_API_KEY=
GEMINI_API_KEY=
# Optional. Defaults to gemini-3.8-flash.
# GEMINI_MODEL=gemini-3.8-flash
# Optional override for conversational shopping. Server only; never put keys in the extension.
# GEMINI_ASSISTANT_MODEL=gemini-3.8-flash
MONGODB_URI=

# Server-only: optional hosted intent sync and public devnet USDC recipient.
LATER_HOSTED_ACCESS_KEY=
LATER_X402_PAY_TO=

# Opt-in local sandbox accounts when MONGODB_URI is absent. No shopper wallets.
LATER_SANDBOX_LOGIN=0
